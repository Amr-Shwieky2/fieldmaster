# Copy to apps/mobile/.env for local development. Expo inlines any variable
# prefixed with EXPO_PUBLIC_ into the JS bundle at start/build time, so never
# put secrets here.

# Base URL of the FieldMaster REST API, including the /api/v1 prefix.
# - iOS Simulator / Expo web:   http://localhost:3000/api/v1
# - Android emulator:           http://10.0.2.2:3000/api/v1
# - Physical phone (Expo Go):   http://<your-computer-LAN-IP>:3000/api/v1
#   (macOS: `ipconfig getifaddr en0`; phone and computer on the same Wi-Fi)
# If port 3000 is taken on your computer (another project), start the API with
# PORT=3010 and use :3010 above (see docs/mobile-device-testing.md).
# After changing this file, restart Metro with --clear: the value is written
# into the bundle.
# EAS builds take their value from the "env" blocks in eas.json instead.
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"
