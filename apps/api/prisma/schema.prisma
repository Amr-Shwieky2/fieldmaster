generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─────────────────────────────────────────────────────────────────────────
// Enums (string values are shared with packages/shared-types)
// ─────────────────────────────────────────────────────────────────────────

enum OrgRole {
  OWNER
  FIELD_MANAGER
  WORKER
}

enum AccountStatus {
  INVITED
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
  ARCHIVED
}

enum CompensationType {
  DAILY
  HOURLY
}

enum ShiftType {
  STANDARD
  DAY_TURAN
  NIGHT_TURAN
  EMERGENCY_CALLOUT
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  OPEN
  ACTIVE
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
  CANCELLED
}

enum CheckInMethod {
  GEOFENCED
  FLEXI_CHECK
}

enum ClockEventType {
  CLOCK_IN
  CLOCK_OUT
}

enum EventOrigin {
  ONLINE
  OFFLINE
}

enum TimeEntryStatus {
  ACTIVE
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CORRECTION_REQUESTED
}

enum LocationValidationStatus {
  PASSED
  FLAGGED
  BLOCKED
  UNAVAILABLE
}

enum CorrectionReason {
  FORGOTTEN_CLOCK_IN
  FORGOTTEN_CLOCK_OUT
  DEVICE_FAILURE
  BROKEN_PHONE
  NO_CONNECTIVITY
  SYSTEM_ERROR
  MANAGER_INSTRUCTION
  OTHER
}

enum TuranType {
  DAY_TURAN
  NIGHT_TURAN
}

enum TuranStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  MISSED
}

enum EmergencyAuthorizationSource {
  NIGHT_TURAN_ASSIGNMENT
  MANUAL_MANAGER_AUTHORIZATION
}

enum TemporaryPointStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum PayrollPeriodStatus {
  OPEN
  CALCULATING
  REVIEW
  FINALIZED
  REOPENED
}

enum PayrollAdjustmentType {
  FORGOTTEN_STAMP_PENALTY
  FORGOTTEN_STAMP_REVERSAL
  MANUAL_DEDUCTION
  MANUAL_BONUS
}

enum PayrollAdjustmentSource {
  SYSTEM
  MANUAL
}

/// Step 8: a report is generated by a background job.
enum ReportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

/// Step 8: what an uploaded file is for.
enum FileAssetPurpose {
  IDENTITY_DOCUMENT
  PROFILE_PHOTO
}

/// Step 7: where a background payroll calculation stands.
enum PayrollCalculationState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ApprovalAction {
  APPROVE
  REJECT
  REQUEST_CORRECTION
}

enum TaskCategory {
  CONSTRUCTION
  TRAFFIC_CONTROL
  TRAFFIC_SIGN
  TRAFFIC_LIGHT_INSTALLATION
  TRAFFIC_LIGHT_REPAIR
  INSPECTION
  MAINTENANCE
  EMERGENCY_REPAIR
  OTHER
}

enum NotificationType {
  WORKER_CLOCKED_IN
  WORKER_CLOCKED_OUT
  OVERTIME_THRESHOLD_CROSSED
  EMERGENCY_SHIFT_STARTED
  EMERGENCY_SHIFT_ENDED
  SHIFT_AWAITING_APPROVAL
  SHIFT_APPROVED
  SHIFT_REJECTED
  ONBOARDING_SUBMITTED
  WORKER_APPROVED
  TURAN_ASSIGNMENT_CREATED
  TURAN_ASSIGNMENT_CHANGED
  TEMPORARY_CHECK_IN_POINT_OPENED
  PAYROLL_FINALIZED
  OFFLINE_EVENT_SYNCED
  OFFLINE_EVENT_REJECTED
  SUSPICIOUS_LOCATION_DETECTED
  TEMPORARY_SUPERVISOR_ISSUE_REPORTED
}

// ─────────────────────────────────────────────────────────────────────────
// Organizations, users, membership, RBAC
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id         String    @id @db.Uuid
  name       String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  settings               OrganizationSettings?
  memberships            OrganizationMembership[]
  onboardingInvitations  OnboardingInvitation[]
  projects               Project[]
  sites                  Site[]
  geofences              Geofence[]
  shifts                 Shift[]
  turanAssignments       TuranAssignment[]
  emergencyCallouts      EmergencyCallout[]
  timeEntries            TimeEntry[]
  forgottenStamps        ForgottenStampInfraction[]
  payrollPeriods         PayrollPeriod[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  temporaryCheckInPoints TemporaryCheckInPoint[]
  offlineSyncBatches     OfflineSyncBatch[]
  rejectedClockAttempts  RejectedClockAttempt[]

  @@map("organizations")
}

model OrganizationSettings {
  id             String       @id @db.Uuid
  organizationId String       @unique @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  timezone                     String  @default("Asia/Jerusalem")
  currency                     String  @default("ILS")
  autoDeductUnpaidBreaks       Boolean @default(false) @map("auto_deduct_unpaid_breaks")
  standardDayMinutes           Int     @default(540) @map("standard_day_minutes")
  deviceTimeDeviationSeconds   Int     @default(120) @map("device_time_deviation_seconds")
  onboardingInvitationTtlHours Int     @default(72) @map("onboarding_invitation_ttl_hours")
  defaultLanguage              String  @default("en") @map("default_language")

  /// Step 6: defaults the API used to hard-code. A shift, site, geofence or
  /// temporary point keeps the value it was created with.
  defaultGraceMinutes             Int  @default(10) @map("default_grace_minutes")
  defaultGeofenceRadiusMeters     Int  @default(100) @map("default_geofence_radius_meters")
  defaultMinGpsAccuracyMeters     Int  @default(50) @map("default_min_gps_accuracy_meters")
  temporaryPointRadiusMeters      Int  @default(100) @map("temporary_point_radius_meters")
  temporaryPointMinAccuracyMeters Int  @default(75) @map("temporary_point_min_accuracy_meters")
  /// Which manager-facing notification events reach Owners / Field Managers:
  /// { [NotificationType]: { owners?: boolean, fieldManagers?: boolean } }.
  /// A missing entry means the default (who received it before Step 6).
  notificationPreferences         Json @default("{}") @map("notification_preferences")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organization_settings")
}

model User {
  id                String        @id @db.Uuid
  phoneNumber       String        @unique @map("phone_number")
  fullLegalName     String        @map("full_legal_name")
  preferredName     String?       @map("preferred_name")
  preferredLanguage String        @default("en") @map("preferred_language")
  status            AccountStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  archivedAt        DateTime?     @map("archived_at")

  memberships          OrganizationMembership[]
  devices              UserDevice[]
  devicePublicKeys     DevicePublicKey[]
  refreshTokenFamilies RefreshTokenFamily[]
  notifications        Notification[]
  auditLogsAsActor     AuditLog[]               @relation("AuditActor")

  @@map("users")
}

model OrganizationMembership {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  role            OrgRole
  isTimeTrackable Boolean       @default(false) @map("is_time_trackable")
  status          AccountStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  archivedAt      DateTime?     @map("archived_at")

  organization         Organization         @relation(fields: [organizationId], references: [id])
  user                 User                 @relation(fields: [userId], references: [id])
  workerProfile        WorkerProfile?
  refreshTokenFamilies RefreshTokenFamily[]

  @@unique([organizationId, userId])
  @@index([organizationId, role, status])
  @@map("organization_memberships")
}

// ─────────────────────────────────────────────────────────────────────────
// Worker profile, sensitive data, compensation
// ─────────────────────────────────────────────────────────────────────────

model WorkerProfile {
  id             String @id @db.Uuid
  membershipId   String @unique @map("membership_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  governmentIdType     String?    @map("government_id_type")
  profilePhotoUrl      String?    @map("profile_photo_url")
  /// Step 8: the profile photo uploaded on the onboarding page (optional).
  profilePhotoAssetId  String?    @unique @map("profile_photo_asset_id") @db.Uuid
  profilePhotoAsset    FileAsset? @relation("WorkerProfilePhoto", fields: [profilePhotoAssetId], references: [id])
  consentAcceptedAt    DateTime?  @map("consent_accepted_at")
  privacyNoticeVersion String?    @map("privacy_notice_version")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  membership                     OrganizationMembership          @relation(fields: [membershipId], references: [id])
  bankAccount                    EncryptedBankAccount?
  identityDocuments              IdentityDocument[]
  compensationProfiles           CompensationProfile[]
  shiftAssignments               ShiftAssignment[]
  temporarySupervisorAssignments TemporarySupervisorAssignment[]
  timeEntries                    TimeEntry[]
  emergencyCallouts              EmergencyCallout[]
  forgottenStamps                ForgottenStampInfraction[]
  payrollItems                   PayrollItem[]
  turanAssignments               TuranAssignment[]               @relation("TuranAssignee")
  turanBackupFor                 TuranAssignment[]               @relation("TuranBackup")
  offlineSyncBatches             OfflineSyncBatch[]
  rejectedClockAttempts          RejectedClockAttempt[]

  @@index([organizationId])
  @@map("worker_profiles")
}

/// Envelope-encrypted at the application layer (AES-256-GCM; local dev key
/// or AWS KMS in production -- see EncryptionService). Never exposed to
/// Field Managers or Temporary Supervisors.
model EncryptedBankAccount {
  id              String        @id @db.Uuid
  workerProfileId String        @unique @map("worker_profile_id") @db.Uuid
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id])

  ciphertext      Bytes  @map("ciphertext")
  iv              Bytes  @map("iv")
  authTag         Bytes  @map("auth_tag")
  encryptionKeyId String @map("encryption_key_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("encrypted_bank_accounts")
}

/// Step 8: a worker's identity document from the onboarding page. The
/// document number is envelope-encrypted (EncryptionService); the image or
/// PDF is a private file asset (MinIO / S3), shown to Owners only through a
/// short-lived signed URL.
model IdentityDocument {
  id              String        @id @db.Uuid
  workerProfileId String        @map("worker_profile_id") @db.Uuid
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id])

  /// GovernmentIdType: ISRAELI_ID or PASSPORT.
  documentType    String @map("document_type")
  /// The encrypted document number.
  ciphertext      Bytes  @map("ciphertext")
  iv              Bytes  @map("iv")
  authTag         Bytes  @map("auth_tag")
  encryptionKeyId String @map("encryption_key_id")

  fileAssetId String?    @unique @map("file_asset_id") @db.Uuid
  fileAsset   FileAsset? @relation("IdentityDocumentFile", fields: [fileAssetId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workerProfileId])
  @@map("identity_documents")
}

/// Step 8: an uploaded file kept in private object storage. Its type comes
/// from its content (magic bytes), image metadata (EXIF and the like) is
/// stripped before it is stored, and it passes the malware-scan hook.
model FileAsset {
  id              String           @id @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  purpose         FileAssetPurpose
  storageKey      String           @unique @map("storage_key")
  /// Detected from the content: image/jpeg, image/png or application/pdf.
  contentType     String           @map("content_type")
  sizeBytes       Int              @map("size_bytes")
  /// SHA-256 of the stored bytes (after metadata stripping).
  sha256          String
  /// CLEAN (the scanner passed it) or NOT_SCANNED (no scanner configured, e.g. in development).
  scanResult      String           @map("scan_result")
  /// The public onboarding upload it came from (before the application links it to a worker).
  invitationId    String?          @map("invitation_id") @db.Uuid
  workerProfileId String?          @map("worker_profile_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")

  identityDocument IdentityDocument? @relation("IdentityDocumentFile")
  profilePhotoOf   WorkerProfile?    @relation("WorkerProfilePhoto")

  @@index([organizationId])
  @@index([invitationId])
  @@index([workerProfileId])
  @@map("file_assets")
}

model CompensationProfile {
  id              String        @id @db.Uuid
  workerProfileId String        @map("worker_profile_id") @db.Uuid
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id])

  compensationType         CompensationType @map("compensation_type")
  dailyBaseRateAgorot      Int?             @map("daily_base_rate_agorot")
  baseHourlyRateAgorot     Int?             @map("base_hourly_rate_agorot")
  overtimeHourlyRateAgorot Int              @map("overtime_hourly_rate_agorot")

  effectiveStartDate DateTime  @map("effective_start_date") @db.Date
  effectiveEndDate   DateTime? @map("effective_end_date") @db.Date

  changeReason String @map("change_reason")
  createdBy    String @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workerProfileId, effectiveStartDate])
  @@map("compensation_profiles")
}

model OnboardingInvitation {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  tokenHash               String    @unique @map("token_hash")
  prefilledPhoneNumber    String?   @map("prefilled_phone_number")
  expiresAt               DateTime  @map("expires_at")
  usedAt                  DateTime? @map("used_at")
  revokedAt               DateTime? @map("revoked_at")
  /// Step 8: who revoked it, and the worker profile its application created.
  revokedBy               String?   @map("revoked_by") @db.Uuid
  redeemedWorkerProfileId String?   @map("redeemed_worker_profile_id") @db.Uuid
  createdBy               String    @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("onboarding_invitations")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth / devices
// ─────────────────────────────────────────────────────────────────────────

model UserDevice {
  id             String @id @db.Uuid
  userId         String @map("user_id") @db.Uuid
  user           User   @relation(fields: [userId], references: [id])
  /// Client-supplied device/install identifier (not guaranteed to be a UUID).
  clientDeviceId String @map("client_device_id")

  platform         String
  appVersion       String?   @map("app_version")
  osVersion        String?   @map("os_version")
  pushToken        String?   @map("push_token")
  lastActiveAt     DateTime? @map("last_active_at")
  attestationState String    @default("UNAVAILABLE") @map("attestation_state")
  riskState        String    @default("NORMAL") @map("risk_state")
  revokedAt        DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  refreshTokenFamilies RefreshTokenFamily[]

  @@unique([userId, clientDeviceId])
  @@index([userId])
  @@map("user_devices")
}

model RefreshTokenFamily {
  id       String     @id @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  user     User       @relation(fields: [userId], references: [id])
  deviceId String     @map("device_id") @db.Uuid
  device   UserDevice @relation(fields: [deviceId], references: [id])

  currentTokenHash String    @map("current_token_hash")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")

  /// Step 6: the membership the session belongs to (null only for sessions
  /// of multi-organization users started before Step 6). Refresh keeps it.
  membershipId String?                 @map("membership_id") @db.Uuid
  membership   OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  /// Last sign-in or refresh: the member's "last active" time.
  lastUsedAt   DateTime                @default(now()) @map("last_used_at")
  /// How the session started: OTP | DEV_LOGIN | DEV_FIXED_OTP (see src/common/auth/login-method.ts).
  origin       String                  @default("OTP")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([membershipId])
  @@map("refresh_token_families")
}

// ─────────────────────────────────────────────────────────────────────────
// Offline attendance sync (spec section 20)
//
// A device generates an Ed25519 keypair on first launch (private key held
// in Keychain/Keystore via expo-secure-store, public key registered here).
// Every clock event captured while offline is signed with that private key
// before being queued locally; the signature is verified against the
// registered public key at sync time so a compromised/rooted device cannot
// forge attendance evidence after the fact, even though the raw event sat
// unsynced on the device for an unknown length of time.
// ─────────────────────────────────────────────────────────────────────────

enum OfflineSyncEventStatus {
  PENDING
  VERIFIED
  FLAGGED
  REJECTED
  DUPLICATE
}

model DevicePublicKey {
  id       String @id @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  /// Matches UserDevice.clientDeviceId / ClockEvent.deviceId (client-supplied, not a FK).
  deviceId String @map("device_id")

  publicKey    String    @map("public_key") // base64-encoded 32-byte Ed25519 public key
  algorithm    String    @default("Ed25519")
  registeredAt DateTime  @default(now()) @map("registered_at")
  revokedAt    DateTime? @map("revoked_at")

  @@unique([userId, deviceId])
  @@index([deviceId])
  @@map("device_public_keys")
}

model OfflineSyncBatch {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  organization    Organization  @relation(fields: [organizationId], references: [id])
  workerProfileId String        @map("worker_profile_id") @db.Uuid
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id])

  deviceId       String   @map("device_id")
  idempotencyKey String?  @map("idempotency_key")
  eventCount     Int      @map("event_count")
  submittedAt    DateTime @default(now()) @map("submitted_at")

  events OfflineSyncEvent[]

  @@index([organizationId, workerProfileId])
  @@map("offline_sync_batches")
}

model OfflineSyncEvent {
  id      String           @id @db.Uuid
  batchId String           @map("batch_id") @db.Uuid
  batch   OfflineSyncBatch @relation(fields: [batchId], references: [id])

  clientEventId   String         @map("client_event_id")
  eventType       ClockEventType @map("event_type")
  deviceTimestamp DateTime       @map("device_timestamp")

  status                 OfflineSyncEventStatus @default(PENDING)
  signatureValid         Boolean                @default(false) @map("signature_valid")
  rejectionReason        String?                @map("rejection_reason")
  offlineEventAgeSeconds Int?                   @map("offline_event_age_seconds")
  resultTimeEntryId      String?                @map("result_time_entry_id") @db.Uuid
  resultClockEventId     String?                @map("result_clock_event_id") @db.Uuid

  payload Json

  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([batchId, clientEventId])
  @@index([clientEventId])
  @@map("offline_sync_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Projects, sites, geofences
// ─────────────────────────────────────────────────────────────────────────

model Project {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name         String
  client       String?
  projectCode  String    @map("project_code")
  description  String?
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  status       String    @default("ACTIVE")
  budgetAgorot Int?      @map("budget_agorot")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  sites  Site[]
  shifts Shift[]

  @@unique([organizationId, projectCode])
  @@index([organizationId, status])
  @@map("projects")
}

model Site {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String       @map("project_id") @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id])

  name                        String
  address                     String?
  latitude                    Float
  longitude                   Float
  defaultGeofenceRadiusMeters Int     @default(100) @map("default_geofence_radius_meters")
  active                      Boolean @default(true)
  instructions                String?
  emergencyContact            String? @map("emergency_contact")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  geofences Geofence[]
  shifts    Shift[]

  @@index([organizationId, active])
  @@map("sites")
}

model Geofence {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  siteId         String       @map("site_id") @db.Uuid
  site           Site         @relation(fields: [siteId], references: [id])

  centerLatitude    Float     @map("center_latitude")
  centerLongitude   Float     @map("center_longitude")
  radiusMeters      Int       @map("radius_meters")
  minAccuracyMeters Int       @default(50) @map("min_accuracy_meters")
  activeFrom        DateTime  @default(now()) @map("active_from")
  activeTo          DateTime? @map("active_to")
  version           Int       @default(1)
  createdBy         String    @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shifts Shift[]

  @@index([siteId])
  @@map("geofences")
}

// ─────────────────────────────────────────────────────────────────────────
// Shifts and assignments
// ─────────────────────────────────────────────────────────────────────────

model Shift {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String?      @map("project_id") @db.Uuid
  project        Project?     @relation(fields: [projectId], references: [id])
  siteId         String?      @map("site_id") @db.Uuid
  site           Site?        @relation(fields: [siteId], references: [id])
  geofenceId     String?      @map("geofence_id") @db.Uuid
  geofence       Geofence?    @relation(fields: [geofenceId], references: [id])

  shiftType      ShiftType     @map("shift_type")
  title          String
  description    String?
  scheduledStart DateTime      @map("scheduled_start")
  scheduledEnd   DateTime      @map("scheduled_end")
  timezone       String        @default("Asia/Jerusalem")
  checkInMethod  CheckInMethod @default(GEOFENCED) @map("check_in_method")
  graceMinutes   Int           @default(10) @map("grace_minutes")
  businessDate   String        @map("business_date") // YYYY-MM-DD in org timezone, derived from scheduledStart

  managerId String      @map("manager_id") @db.Uuid
  status    ShiftStatus @default(DRAFT)

  flaggedLongRunning Boolean @default(false) @map("flagged_long_running")

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  closedAt    DateTime? @map("closed_at")
  closedBy    String?   @map("closed_by") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at")

  assignments            ShiftAssignment[]
  temporarySupervisors   TemporarySupervisorAssignment[]
  temporaryCheckInPoints TemporaryCheckInPoint[]
  timeEntries            TimeEntry[]
  rejectedClockAttempts  RejectedClockAttempt[]

  @@index([organizationId, status])
  @@index([organizationId, businessDate])
  @@map("shifts")
}

model ShiftAssignment {
  id              String        @id @db.Uuid
  shiftId         String        @map("shift_id") @db.Uuid
  shift           Shift         @relation(fields: [shiftId], references: [id])
  workerProfileId String        @map("worker_profile_id") @db.Uuid
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id])

  assignedBy String    @map("assigned_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  removedAt  DateTime? @map("removed_at")

  @@unique([shiftId, workerProfileId])
  @@index([workerProfileId])
