/// A clock-in or clock-out the server refused because of where the phone was
/// or what its clock said (outside the geofence, GPS accuracy too low, device
/// clock off, mock location). The worker gets exactly the same error as
/// before; this row is the evidence managers see on the attendance detail
/// page. Attempts at a clock-in are linked to the time entry the worker later
/// opens for the same shift; a refused clock-out is linked to the open entry
/// it was meant to close.
model RejectedClockAttempt {
  id              String        @id @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  organization    Organization  @relation(fields: [organizationId], references: [id])
  workerProfileId String        @map("worker_profile_id") @db.Uuid
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id])
  shiftId         String        @map("shift_id") @db.Uuid
  shift           Shift         @relation(fields: [shiftId], references: [id])
  timeEntryId     String?       @map("time_entry_id") @db.Uuid
  timeEntry       TimeEntry?    @relation(fields: [timeEntryId], references: [id])

  eventType ClockEventType @map("event_type")
  origin    EventOrigin
  /// The error code the worker received (e.g. GEOFENCE_OUTSIDE_ALLOWED_RADIUS).
  code      String

  deviceTimestamp  DateTime @map("device_timestamp")
  serverReceivedAt DateTime @default(now()) @map("server_received_at")
  deviationSeconds Int?     @map("deviation_seconds")

  latitude              Float
  longitude             Float
  accuracyMeters        Float   @map("accuracy_meters")
  mockLocationSuspected Boolean @default(false) @map("mock_location_suspected")

  distanceMeters          Float?                 @map("distance_meters")
  allowedRadiusMeters     Int?                   @map("allowed_radius_meters")
  requiredAccuracyMeters  Int?                   @map("required_accuracy_meters")
  temporaryCheckInPointId String?                @map("temporary_check_in_point_id") @db.Uuid
  temporaryCheckInPoint   TemporaryCheckInPoint? @relation(fields: [temporaryCheckInPointId], references: [id])

