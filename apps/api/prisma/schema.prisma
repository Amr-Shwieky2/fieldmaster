  requestIp     String? @map("request_ip")
  userAgent     String? @map("user_agent")
  correlationId String  @map("correlation_id")

  previousHash String @map("previous_hash")
  currentHash  String @map("current_hash")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id              String       @id @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  recipientUserId String       @map("recipient_user_id") @db.Uuid
  recipient       User         @relation(fields: [recipientUserId], references: [id])

  type     NotificationType
  title    String
  body     String
  dataJson Json?            @map("data_json")
  readAt   DateTime?        @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  deliveries NotificationDelivery[]

  @@index([organizationId, recipientUserId, readAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String       @id @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id])

  channel     String
  status      String    @default("PENDING")
  attemptedAt DateTime? @map("attempted_at")
  deliveredAt DateTime? @map("delivered_at")
  error       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([notificationId])
  @@map("notification_deliveries")
}

model OtpChallenge {
  id          String    @id @db.Uuid
  phoneNumber String    @map("phone_number")
  provider    String    @default("CONSOLE")
  codeHash    String?   @map("code_hash")
  providerRef String?   @map("provider_ref")
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([phoneNumber, createdAt])
  @@map("otp_challenges")
}

model IdempotencyRecord {
  id               String @id @db.Uuid
  key              String
  route            String
  requestHash      String @map("request_hash")
  responseStatus   Int?   @map("response_status")
  responseBodyJson Json?  @map("response_body_json")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([key, route])
  @@map("idempotency_records")
}

/// A generated, tamper-evident PDF (spec section 25). The PDF bytes live in
/// S3/MinIO under storageKey; this row is the audit trail of who generated
/// what, from which filters, and its SHA-256 hash.
/// A generated report (Step 8: a BullMQ job writes both a PDF and a CSV).
/// `sha256Hash` is the hash of the report's source data, printed in every
/// PDF footer; `pdfSha256` / `csvSha256` are the hashes of the stored files,
/// which `GET /reports/:id/verify` recomputes.
model GeneratedReport {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  reportType             String  @map("report_type")
  requestedByUserId      String  @map("requested_by_user_id") @db.Uuid
  subjectWorkerProfileId String? @map("subject_worker_profile_id") @db.Uuid
  filtersJson            Json    @map("filters_json")
  includesFinancials     Boolean @default(false) @map("includes_financials")

  templateVersion String  @map("template_version")
  sha256Hash      String? @map("sha256_hash")
  /// The PDF's storage key (null until the job has written it).
  storageKey      String? @map("storage_key")
  csvStorageKey   String? @map("csv_storage_key")
  pdfSha256       String? @map("pdf_sha256")
  csvSha256       String? @map("csv_sha256")
  pageCount       Int?    @map("page_count")

  /// Step 8: the background job. Reports generated before Step 8 are READY.
  status         ReportStatus @default(READY)
  progress       Int          @default(100)
  idempotencyKey String?      @map("idempotency_key")
  errorCode      String?      @map("error_code")
  errorMessage   String?      @map("error_message")
  startedAt      DateTime?    @map("started_at")
  finishedAt     DateTime?    @map("finished_at")

  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([organizationId, subjectWorkerProfileId])
  @@index([organizationId, generatedAt])
  @@map("generated_reports")
}
