# Copy to .env for local development. All defaults below work with
# `docker compose up -d` and require no paid external accounts.

# --- Database ---
DATABASE_URL="postgresql://fieldmaster:fieldmaster_dev_password@localhost:5433/fieldmaster?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- App ---
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3001,http://localhost:8081"

# --- Auth ---
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_TTL="30d"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Application-layer encryption for bank accounts / identity documents ---
# Development: a local 32-byte base64 key used directly (see EncryptionService).
# Production: set KMS_KEY_ID and the app performs envelope encryption via AWS KMS.
LOCAL_ENCRYPTION_KEY_BASE64="3flOAwkmbM8Wbu+jPivo+sMVLbSkA8+as2wLULpw16c="
KMS_KEY_ID=""

# --- SMS / OTP delivery ---
# Leave TWILIO_ACCOUNT_SID empty to use the dev console adapter, which prints
# the OTP to the API log instead of sending a real SMS.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# --- Push notifications ---
# Leave empty to use the dev adapter, which logs push payloads instead of
# calling Firebase.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Object storage ---
# Local development uses the MinIO container started by docker-compose.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fieldmaster-dev"
S3_ACCESS_KEY_ID="fieldmaster"
S3_SECRET_ACCESS_KEY="fieldmaster_dev_password"
S3_FORCE_PATH_STYLE=true

# --- Maps / geocoding ---
# Leave empty in development; server-side geofence validation uses PostGIS
# and does not require Google Maps. Required for the admin web map UI.
GOOGLE_MAPS_API_KEY=""

# --- Observability ---
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
LOG_LEVEL="debug"
