# Copy to .env for local development. All defaults below work with
# `docker compose up -d` and require no paid external accounts.

# --- Database ---
DATABASE_URL="postgresql://fieldmaster:fieldmaster_dev_password@localhost:5433/fieldmaster?schema=public"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- App ---
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3001,http://localhost:8081"
# TRUST_PROXY: the number of proxies / load balancers in front of the API
# (Render: 1). The rate limits then use the client's address from
# X-Forwarded-For instead of the proxy's. Leave 0 when nothing is in front:
# a client could otherwise forge that header.
TRUST_PROXY=0
# ONBOARDING_RATE_LIMIT: requests per minute per IP address on each public
# onboarding route (the join page, its uploads and the application). Default 10.
ONBOARDING_RATE_LIMIT=10

# --- Environment & test login ---
# APP_ENV: development | staging | production. What kind of deployment this
# is (separate from NODE_ENV, which only says how the code was built). When
# unset it follows NODE_ENV (production -> production, else development).
APP_ENV="development"
# DEV_LOGIN_ENABLED: true | false. Test login without SMS: every phone number
# accepts the fixed code 123456, and GET /api/v1/auth/dev/users +
# POST /api/v1/auth/dev/login allow one-click login as any active member.
# Only honoured when APP_ENV is development or staging; APP_ENV=production
# with DEV_LOGIN_ENABLED=true makes the API refuse to start. When false the
# dev endpoints return 404 and the web/mobile login screens hide the test
# options. NEVER enable it on a deployment that holds real data.
DEV_LOGIN_ENABLED=true
# OTP_PROVIDER (optional): console | twilio | dev-fixed. Pins the OTP
# provider. Unset = automatic: dev-fixed in dev login mode, otherwise twilio
# when TWILIO_ACCOUNT_SID is set, otherwise console (prints the code to the
# API log). In dev login mode only dev-fixed (or unset) is accepted.
OTP_PROVIDER=""

# --- Auth ---
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_TTL="30d"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# The device-clock deviation limit is an organization setting since Step 6
# (organization_settings.device_time_deviation_seconds, default 120; edited on
# the admin web's settings page), not an environment variable.

# --- Application-layer encryption for bank accounts / identity documents ---
# Development: a local 32-byte base64 key used directly (see EncryptionService).
# Production: set KMS_KEY_ID and the app performs envelope encryption via AWS KMS.
LOCAL_ENCRYPTION_KEY_BASE64="3flOAwkmbM8Wbu+jPivo+sMVLbSkA8+as2wLULpw16c="
KMS_KEY_ID=""

# --- SMS / OTP delivery ---
# Leave TWILIO_ACCOUNT_SID empty to use the dev console adapter, which prints
# the OTP to the API log instead of sending a real SMS.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# --- Push notifications (Step 9) ---
# PUSH_PROVIDER: log | expo. Default log: nothing leaves the API; one log line
# per notification (type, id, device count -- never a push token or the text).
# expo: Expo's push service (https://exp.host/--/api/v2/push/send), which
# delivers to iOS (APNs) and Android (FCM) with the credentials configured in
# the Expo project. Push follows each member's own preferences; in-app
# notifications are always kept.
PUSH_PROVIDER="log"
# EXPO_ACCESS_TOKEN (optional): only when the Expo project has "enhanced push
# security" turned on. Never logged.
EXPO_ACCESS_TOKEN=""

# --- Voice summary transcription (Step 9) ---
# TRANSCRIPTION_PROVIDER: mock | none. Unset: mock in development, staging and
# tests (a fixed Arabic sentence for every recording), none in production
# (POST /attachments/:id/transcription answers 503 TRANSCRIPTION_UNAVAILABLE and
# the app asks the worker to type the summary). mock is refused when
# APP_ENV=production. A real provider is a new value with its own adapter.
TRANSCRIPTION_PROVIDER=""

# --- Object storage ---
# Local development uses the MinIO container started by docker-compose.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fieldmaster-dev"
S3_ACCESS_KEY_ID="fieldmaster"
S3_SECRET_ACCESS_KEY="fieldmaster_dev_password"
S3_FORCE_PATH_STYLE=true

# --- Maps / geocoding ---
# Leave empty in development; server-side geofence validation uses PostGIS
# and does not require Google Maps. Required for the admin web map UI.
GOOGLE_MAPS_API_KEY=""

# --- Observability ---
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
LOG_LEVEL="debug"
