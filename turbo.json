{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "NEXT_PUBLIC_API_URL", "CORS_ORIGINS", "APP_ENV", "DEV_LOGIN_ENABLED"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_*",
        "LOCAL_ENCRYPTION_KEY_BASE64",
        "FIELDMASTER_TEST_OTP",
        "OTP_*",
        "DEVICE_TIME_DEVIATION_SECONDS",
        "CORS_ORIGINS",
        "NODE_ENV",
        "APP_ENV",
        "DEV_LOGIN_ENABLED",
        "S3_*"
      ]
    }
  }
}
