{
  "name": "@fieldmaster/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Arabic UI text and formatting shared by the admin web and the mobile app.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./messages/ar.json": "./src/messages/ar.json",
    "./check": "./scripts/i18n-check.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/check-shared.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fieldmaster/api-client": "workspace:*",
    "@fieldmaster/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@fieldmaster/typescript-config": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "use-intl": "4.14.9"
  },
  "typesVersions": {
    "*": {
      "node": [
        "dist/node.d.ts"
      ]
    }
  }
}
