{
  "name": "fieldmaster",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @fieldmaster/api db:migrate",
    "db:seed": "pnpm --filter @fieldmaster/api db:seed",
    "db:generate": "pnpm --filter @fieldmaster/api db:generate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@^0.8": "^0.8.15",
      "@xmldom/xmldom@^0.9": "^0.9.12",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "brace-expansion@^5": "^5.0.12",
      "compression": "^1.8.2",
      "engine.io": "^6.6.10",
      "fast-uri@^3": "^3.1.8",
      "glob@^10": "^10.5.0",
      "handlebars": "^4.7.10",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "lodash": "^4.18.0",
      "multer": "^2.3.0",
      "nanoid@^3": "^3.3.18",
      "picomatch@^4": "^4.0.4",
      "postcss@^8": "^8.5.23",
      "proxy-addr": "^2.0.8",
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2",
      "tmp@<0.2.6": "^0.2.6"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687",
        "CVE-2026-85393"
      ]
    }
  }
}
